# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Older projects call this the anon key; VITE_SUPABASE_ANON_KEY also works
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional: shown on the car page next to "Member since"
VITE_BUSINESS_LOCATION=Abuja, Nigeria
